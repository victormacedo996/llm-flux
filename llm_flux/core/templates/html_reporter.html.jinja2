<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pipeline Compression Report - {{ pipeline_name }}</title>
    <script src="https://cdn.jsdelivr.net/npm/echarts@6.0.0/dist/echarts.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #0d6efd;
            --success-color: #198754;
            --danger-color: #dc3545;
            --warning-color: #ffc107;
            --secondary-color: #6c757d;
            --light-bg: #f8f9fa;
            --card-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
                'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 30px 15px;
        }

        .container-fluid { max-width: 1400px; margin: 0 auto; }

        header {
            background: white;
            padding: 40px 30px;
            border-radius: 12px;
            box-shadow: var(--card-shadow);
            margin-bottom: 30px;
        }

        header h1 {
            color: var(--primary-color);
            margin-bottom: 10px;
            font-weight: 700;
        }

        header p {
            color: var(--secondary-color);
            margin: 5px 0;
            font-size: 1.05rem;
        }

        .header-meta {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #e9ecef;
        }

        .meta-item { display: flex; flex-direction: column; }
        .meta-label {
            font-size: 0.85rem;
            color: var(--secondary-color);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }
        .meta-value {
            font-size: 1.3rem;
            color: #212529;
            margin-top: 5px;
            font-weight: 600;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #212529;
            margin-top: 30px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 3px solid var(--primary-color);
        }

        .dag-container {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: var(--card-shadow);
            margin-bottom: 30px;
            text-align: center;
        }

        .dag-container img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            border: 2px solid #e9ecef;
        }

        .charts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
            gap: 30px;
            margin-bottom: 30px;
        }

        .chart-container {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: var(--card-shadow);
        }

        .chart-container h3 {
            color: #212529;
            margin-bottom: 20px;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .chart-wrapper {
            position: relative;
            height: 400px;
        }

        .table-container {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: var(--card-shadow);
            margin-bottom: 30px;
            overflow-x: auto;
        }

        .table-container h3 {
            color: #212529;
            margin-bottom: 20px;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .table-container table {
            width: 100%;
            border-collapse: collapse;
        }

        .table-container thead {
            background: var(--light-bg);
            border-bottom: 2px solid #dee2e6;
        }

        .table-container th {
            padding: 12px;
            text-align: center;
            font-weight: 600;
            color: #495057;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .table-container td {
            padding: 12px;
            border-bottom: 1px solid #dee2e6;
            text-align: center;
        }

        .table-container tbody tr:hover { background: var(--light-bg); }
        .table-container .record-row { cursor: pointer; }

        .badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .badge-success { background: #d1e7dd; color: #0f5132; }
        .badge-secondary { background: #e2e3e5; color: #41464b; }

        .details-panel {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: var(--card-shadow);
            margin-bottom: 30px;
            display: none;
        }

        .details-panel.active {
            display: block;
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .detail-section { margin-bottom: 20px; }
        .detail-section h5 {
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 10px;
            font-size: 1rem;
        }

        .detail-item {
            padding: 12px;
            background: var(--light-bg);
            border-left: 4px solid var(--primary-color);
            border-radius: 4px;
            margin-bottom: 8px;
        }

        .detail-label {
            font-size: 0.8rem;
            color: var(--secondary-color);
            text-transform: uppercase;
            letter-spacing: 0.3px;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .detail-value {
            font-size: 1.1rem;
            color: #212529;
            font-weight: 600;
            font-family: 'Courier New', monospace;
            word-break: break-all;
        }

        footer {
            background: rgba(255, 255, 255, 0.9);
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            color: var(--secondary-color);
            font-size: 0.9rem;
            margin-top: 30px;
        }

        .ppl-hidden { {% if not has_perplexity %}display: none;{% endif %} }

        @media (max-width: 768px) {
            .charts-grid { grid-template-columns: 1fr; }
            header { padding: 25px 15px; }
            .header-meta { grid-template-columns: 1fr; }
            .chart-container, .table-container, .details-panel { padding: 15px; }
            .details-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <header>
            <h1>🔬 Pipeline Compression Report</h1>
            <p class="mb-0"><strong>{{ pipeline_name }}</strong></p>
            <p class="mb-0">{{ pipeline_description }}</p>
            <div class="header-meta">
                <div class="meta-item">
                    <span class="meta-label">Duration</span>
                    <span class="meta-value">{{ "%.2f"|format(duration_seconds) }}s</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Pipeline Stages</span>
                    <span class="meta-value">{{ num_stages }}</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Started</span>
                    <span class="meta-value">{{ started_at }}</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Finished</span>
                    <span class="meta-value">{{ finished_at }}</span>
                </div>
            </div>
        </header>

        {% if dag_image_data_url or dag_echarts_data_json %}
        <h2 class="section-title">📊 Pipeline Execution DAG</h2>
        <div class="dag-container">
            {% if dag_echarts_data_json %}
            <div id="dagChart" style="width: 100%; height: 400px;"></div>
            {% else %}
            <img src="{{ dag_image_data_url }}" alt="Pipeline DAG">
            {% endif %}
        </div>
        {% endif %}

        {% if profiling_data_json %}
            <h2 class="section-title">⚙️ Hardware Information</h2>
            <div class="table-container">
                <div class="details-grid" id="hardwareContent"></div>
            </div>
        {% endif %}

        <h2 class="section-title">📈 Performance Metrics</h2>
        <div class="charts-grid">
            <div class="chart-container">
                <h3>⏱️ Latency Progression</h3>
                <div class="chart-wrapper" id="latencyChart"></div>
            </div>
            <div class="chart-container">
                <h3>💾 GPU Memory Usage</h3>
                <div class="chart-wrapper" id="memoryChart"></div>
            </div>
            {% if has_perplexity %}
            <div class="chart-container">
                <h3>📊 Model Perplexity</h3>
                <div class="chart-wrapper" id="perplexityChart"></div>
            </div>
            {% endif %}
        </div>

        <h2 class="section-title">📋 Detailed Metrics Table</h2>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Pipeline Stage</th>
                        <th>Mean Latency</th>
                        <th>P50 Latency</th>
                        <th>P95 Latency</th>
                        <th>P99 Latency</th>
                        <th>Test Name</th>
                        <th class="ppl-hidden">Perplexity</th>
                    </tr>
                </thead>
                <tbody id="metricsTableBody"></tbody>
            </table>
        </div>

        <div class="details-panel" id="detailsPanel">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 style="margin: 0;">📌 Stage Details</h4>
                <button type="button" class="btn-close" onclick="closeDetails()"></button>
            </div>
            <div id="detailsContent" class="details-grid"></div>
        </div>

        <footer>Generated by LLM-Flux Pipeline Reporter | Report generated at <span id="reportTime"></span></footer>
    </div>

    <script>
        const stages = JSON.parse({{ stages_json | tojson | safe }});
        const latenciesMean = JSON.parse({{ latencies_mean_json | tojson | safe }});
        const latenciesP50 = JSON.parse({{ latencies_p50_json | tojson | safe }});
        const latenciesP95 = JSON.parse({{ latencies_p95_json | tojson | safe }});
        const gpuPeaks = JSON.parse({{ gpu_peaks_json | tojson | safe }});
        const perplexities = JSON.parse({{ perplexities_json | tojson | safe }});
        const hasPerplexity = JSON.parse({{ has_perplexity | lower }});
        const profilingData = JSON.parse({{ profiling_data_json | tojson | safe }});
        const dagEchartsData = {{ dag_echarts_data_json | default('null') | safe }};

        document.getElementById('reportTime').textContent = new Date().toLocaleString();

        const chartColors = {
            primary: '#0d6efd',
            success: '#198754',
            danger: '#dc3545',
            warning: '#ffc107',
            secondary: '#6c757d',
        };

        // Latency Chart
        const latencyChart = echarts.init(document.getElementById('latencyChart'));
        latencyChart.setOption({
            tooltip: { trigger: 'axis' },
            legend: { textStyle: { fontSize: 12 } },
            grid: { left: 60, right: 20, top: 30, bottom: 50, containLabel: true },
            xAxis: {
                type: 'category',
                data: stages,
                axisLabel: { interval: 0, rotate: 45 }
            },
            yAxis: { type: 'value', name: 'Latency (ms)' },
            series: [
                {
                    name: 'Mean Latency',
                    data: latenciesMean,
                    type: 'line',
                    smooth: true,
                    itemStyle: { color: chartColors.primary },
                    areaStyle: { color: 'rgba(13, 110, 253, 0.1)' },
                    symbolSize: 8
                },
                {
                    name: 'P95 Latency',
                    data: latenciesP95,
                    type: 'line',
                    smooth: true,
                    itemStyle: { color: chartColors.danger },
                    lineStyle: { type: 'dashed' },
                    symbolSize: 6
                }
            ]
        });

        // Render ECharts DAG if available
        if (dagEchartsData) {
            const dagChart = echarts.init(document.getElementById('dagChart'));
            dagChart.setOption(dagEchartsData);
            window.addEventListener('resize', () => dagChart.resize());
        }

        // Memory Chart
        const memoryChart = echarts.init(document.getElementById('memoryChart'));
        memoryChart.setOption({
            tooltip: { trigger: 'axis' },
            legend: { textStyle: { fontSize: 12 } },
            grid: { left: 60, right: 20, top: 30, bottom: 50, containLabel: true },
            xAxis: {
                type: 'category',
                data: stages,
                axisLabel: { interval: 0, rotate: 45 }
            },
            yAxis: { type: 'value', name: 'Memory (MB)' },
            series: [
                {
                    name: 'GPU Peak Memory',
                    data: gpuPeaks,
                    type: 'bar',
                    itemStyle: { color: chartColors.success },
                    itemStyle: { borderRadius: [5, 5, 0, 0] }
                }
            ]
        });

        // Perplexity Chart
        if (hasPerplexity) {
            const perplexityChart = echarts.init(document.getElementById('perplexityChart'));
            perplexityChart.setOption({
                tooltip: { trigger: 'axis' },
                legend: { textStyle: { fontSize: 12 } },
                grid: { left: 60, right: 20, top: 30, bottom: 50, containLabel: true },
                xAxis: {
                    type: 'category',
                    data: stages,
                    axisLabel: { interval: 0, rotate: 45 }
                },
                yAxis: { type: 'value', name: 'Perplexity' },
                series: [
                    {
                        name: 'Model Perplexity',
                        data: perplexities,
                        type: 'line',
                        smooth: true,
                        itemStyle: { color: chartColors.warning },
                        areaStyle: { color: 'rgba(255, 193, 7, 0.1)' },
                        symbolSize: 8
                    }
                ]
            });
        }

        // Build metrics table
        function buildMetricsTable() {
            const tbody = document.getElementById('metricsTableBody');
            profilingData.forEach((record, idx) => {
                const row = document.createElement('tr');
                row.className = 'record-row';
                row.dataset.index = idx;
                row.style.cursor = 'pointer';

                const pplValue = record.perplexity ? 
                    `<span class="badge badge-success">${record.perplexity.toFixed(3)}</span>` : 
                    `<span class="badge badge-secondary">—</span>`;

                const gpuMemory = record.gpu_memory ? `${record.gpu_memory.toFixed(1)} MB` : '—';
                const cpuMemory = record.cpu_memory ? `${record.cpu_memory.toFixed(1)} MB` : '—';

                row.innerHTML = `
                    <td class="text-center">${idx + 1}</td>
                    <td><strong>${record.stage}</strong></td>
                    <td class="text-center">${record.latency_mean.toFixed(2)} ms</td>
                    <td class="text-center">${record.latency_p50.toFixed(2)} ms</td>
                    <td class="text-center">${record.latency_p95.toFixed(2)} ms</td>
                    <td class="text-center">${record.latency_p99.toFixed(2)} ms</td>
                    <td class="text-center">${record.test_name}</td>
                    <td class="text-center ppl-hidden">${pplValue}</td>
                `;

                row.addEventListener('click', () => showDetails(idx));
                tbody.appendChild(row);
            });
        }

        function showDetails(index) {
            const record = profilingData[index];
            const detailsContent = document.getElementById('detailsContent');

            let html = `
                <div class="detail-section">
                    <h5>⏱️ Latency Metrics</h5>
                    <div class="detail-item">
                        <div class="detail-label">Mean Latency</div>
                        <div class="detail-value">${record.latency_mean.toFixed(2)} ms</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">P50 Latency</div>
                        <div class="detail-value">${record.latency_p50.toFixed(2)} ms</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">P95 Latency</div>
                        <div class="detail-value">${record.latency_p95.toFixed(2)} ms</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">P99 Latency</div>
                        <div class="detail-value">${record.latency_p99.toFixed(2)} ms</div>
                    </div>
                </div>

                <div class="detail-section">
                    <h5>💾 Memory Metrics</h5>
                    <div class="detail-item">
                        <div class="detail-label">GPU Peak Memory</div>
                        <div class="detail-value">${record.gpu_memory ? record.gpu_memory.toFixed(1) + ' MB' : '—'}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">CPU Peak Memory</div>
                        <div class="detail-value">${record.cpu_memory ? record.cpu_memory.toFixed(1) + ' MB' : '—'}</div>
                    </div>
                </div>
            `;

            if (record.perplexity !== null) {
                html += `
                    <div class="detail-section">
                        <h5>📊 Accuracy Metrics</h5>
                        <div class="detail-item">
                            <div class="detail-label">Perplexity</div>
                            <div class="detail-value">${record.perplexity.toFixed(3)}</div>
                        </div>
                    </div>
                `;
            }

            if (record.model && Object.keys(record.model).length > 0) {
                html += `
                    <div class="detail-section">
                        <h5>🤖 Model Information</h5>
                        <div class="detail-item">
                            <div class="detail-label">Model Class</div>
                            <div class="detail-value">${record.model.model_class}</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Total Parameters</div>
                            <div class="detail-value">${record.model.total_parameters_millions.toFixed(2)}M</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Total Layers</div>
                            <div class="detail-value">${record.model.total_layers}</div>
                        </div>
                    </div>
                `;
            }

            detailsContent.innerHTML = html;
            document.getElementById('detailsPanel').classList.add('active');
        }

        function closeDetails() {
            document.getElementById('detailsPanel').classList.remove('active');
        }

        function renderHardwareSection() {
    const hardwareContent = document.getElementById('hardwareContent');
    if (!hardwareContent) return;

    const firstRecordWithHardware = profilingData.find(
        record => record.hardware && Object.keys(record.hardware).length > 0
    );

    if (!firstRecordWithHardware) {
        hardwareContent.innerHTML = `
            <div class="detail-section">
                <div class="detail-item">
                    <div class="detail-label">Hardware</div>
                    <div class="detail-value">No hardware information available</div>
                </div>
            </div>
        `;
        return;
    }

    const hardware = firstRecordWithHardware.hardware;

    hardwareContent.innerHTML = `
        <div class="detail-section">
            <h5>⚙️ Hardware Information</h5>

            <div class="detail-item">
                <div class="detail-label">CPU</div>
                <div class="detail-value">${hardware.cpu_name ?? '—'}</div>
            </div>

            <div class="detail-item">
                <div class="detail-label">CPU Cores</div>
                <div class="detail-value">${hardware.cpu_cores ?? '—'}</div>
            </div>

            <div class="detail-item">
                <div class="detail-label">Total RAM</div>
                <div class="detail-value">
                    ${hardware.total_ram_gb !== undefined && hardware.total_ram_gb !== null
                        ? hardware.total_ram_gb.toFixed(1) + ' GB'
                        : '—'}
                </div>
            </div>

            <div class="detail-item">
                <div class="detail-label">GPU Available</div>
                <div class="detail-value">${hardware.cuda_available ? 'Yes' : 'No'}</div>
            </div>

            <div class="detail-item">
                <div class="detail-label">GPU Count</div>
                <div class="detail-value">${hardware.gpu_count ?? '—'}</div>
            </div>
        </div>
    `;
    }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeDetails();
        });

        buildMetricsTable();
        renderHardwareSection();
        window.addEventListener('resize', () => {
            latencyChart.resize();
            memoryChart.resize();
            if (hasPerplexity) {
                echarts.getInstanceByDom(document.getElementById('perplexityChart')).resize();
            }
        });
    </script>
</body>
</html>