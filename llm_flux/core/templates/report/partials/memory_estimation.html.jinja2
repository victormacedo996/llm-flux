<h2 class="section-title">💾 Memory Estimation</h2>
<div class="accordion" id="memEstAccordion">
{% for pd in profiling_data_json | from_json %}
{% set idx = loop.index0 %}
{% set m = pd.model %}
{% if m and m.memory_estimates %}
<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button{% if not loop.first %} collapsed{% endif %}"
                type="button" data-bs-toggle="collapse"
                data-bs-target="#memBody{{ idx }}"
                aria-expanded="{{ 'true' if loop.first else 'false' }}">
            💾 {{ pd.stage }}
            <span class="ms-3 badge-inline">{{ m.model_class }}</span>
        </button>
    </h2>
    <div id="memBody{{ idx }}" class="accordion-collapse collapse{% if loop.first %} show{% endif %}">
        <div class="accordion-body">
            <div class="precision-table-wrap">
                <table class="precision-table mem-table">
                    <thead>
                        <tr>
                            <th>Precision</th>
                            <th>Bytes/Param</th>
                            <th>Weights (MB)</th>
                            <th>KV-Cache (MB)</th>
                            <th>Activations (MB)</th>
                            <th>Inference (MB)</th>
                            <th>Gradients (MB)</th>
                            <th>Optimizer (MB)</th>
                            <th>Training (MB)</th>
                            <th>Total (GB)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for prec, est in m.memory_estimates.items() %}
                        <tr class="mem-row-{{ prec }}">
                            <td><span class="prec-badge prec-{{ prec }}">{{ prec | upper }}</span></td>
                            <td>{{ est.bytes_per_parameter }}</td>
                            <td>{{ est.model_weights_mb }}</td>
                            <td>{{ est.kv_cache_mb if est.kv_cache_mb is not none else '—' }}</td>
                            <td>{{ est.activation_memory_mb if est.activation_memory_mb is not none else '—' }}</td>
                            <td class="mem-highlight">{{ est.total_inference_memory_mb }}</td>
                            <td>{{ est.gradient_memory_mb }}</td>
                            <td>{{ est.optimizer_memory_mb }}</td>
                            <td>{{ est.training_memory_mb }}</td>
                            <td class="mem-highlight-total">{{ est.total_memory_gb }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <p class="mem-footnote">
                Inference total includes a 1.2× overhead factor. Training total includes a 1.3× overhead factor.
            </p>
        </div>
    </div>
</div>
{% endif %}
{% endfor %}
</div>
