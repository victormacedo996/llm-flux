<h2 class="section-title">📊 Benchmark Results</h2>
<div class="accordion" id="benchmarksAccordion">
{% for pd in profiling_data_json | from_json %}
{% set idx = loop.index0 %}
{% if pd.benchmarks %}
<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button{% if not loop.first %} collapsed{% endif %}"
                type="button" data-bs-toggle="collapse"
                data-bs-target="#benchBody{{ idx }}"
                aria-expanded="{{ 'true' if loop.first else 'false' }}">
            📊 {{ pd.stage }}
            {% for b in pd.benchmarks %}
            {% if b.kind == 'perplexity' %}
            <span class="ms-3 badge-inline">{{ b.test_name }}: PPL {{ '%.2f'|format(b.mean_perplexity) }}</span>
            {% elif b.kind == 'accuracy' %}
            <span class="ms-3 badge-inline">{{ b.test_name }}: Acc {{ '%.1f'|format(b.accuracy * 100) }}%</span>
            {% endif %}
            {% endfor %}
        </button>
    </h2>
    <div id="benchBody{{ idx }}" class="accordion-collapse collapse{% if loop.first %} show{% endif %}">
        <div class="accordion-body">
            {% for b in pd.benchmarks %}
            <div class="bench-block mb-4">
                <h6 class="bench-title">{{ b.test_name | upper }}</h6>
                {% if b.kind == 'perplexity' %}
                <div class="stat-grid">
                    <div class="stat-card stat-card--warning">
                        <div class="stat-label">Mean Perplexity</div>
                        <div class="stat-value">{{ '%.3f'|format(b.mean_perplexity) }}</div>
                    </div>
                    {% if b.stats %}
                    <div class="stat-card stat-card--secondary">
                        <div class="stat-label">Std Dev</div>
                        <div class="stat-value">{{ '%.3f'|format(b.stats.std) }}</div>
                    </div>
                    <div class="stat-card stat-card--secondary">
                        <div class="stat-label">Min / Max</div>
                        <div class="stat-value">{{ '%.3f'|format(b.stats.min) }} / {{ '%.3f'|format(b.stats.max) }}</div>
                    </div>
                    <div class="stat-card stat-card--secondary">
                        <div class="stat-label">P5 / P50 / P95</div>
                        <div class="stat-value">{{ '%.3f'|format(b.stats.p5) }} / {{ '%.3f'|format(b.stats.median) }} / {{ '%.3f'|format(b.stats.p95) }}</div>
                    </div>
                    {% endif %}
                    <div class="stat-card stat-card--secondary">
                        <div class="stat-label">Samples Evaluated</div>
                        <div class="stat-value">{{ b.all_perplexities | length }}</div>
                    </div>
                </div>
                {% if b.all_perplexities | length > 0 %}
                <div class="mt-3">
                    <p class="bench-subtitle">Per-sample Perplexities</p>
                    <div class="ppl-samples">
                        {% for ppl in b.all_perplexities %}
                        <span class="ppl-chip">{{ '%.2f'|format(ppl) }}</span>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {% elif b.kind == 'accuracy' %}
                <div class="stat-grid">
                    <div class="stat-card stat-card--success">
                        <div class="stat-label">Accuracy</div>
                        <div class="stat-value">{{ '%.2f'|format(b.accuracy * 100) }}<span class="stat-unit">%</span></div>
                    </div>
                    {% if b.stats %}
                    <div class="stat-card stat-card--secondary">
                        <div class="stat-label">Std Dev</div>
                        <div class="stat-value">{{ '%.3f'|format(b.stats.std) }}</div>
                    </div>
                    <div class="stat-card stat-card--secondary">
                        <div class="stat-label">Min / Max</div>
                        <div class="stat-value">{{ '%.3f'|format(b.stats.min) }} / {{ '%.3f'|format(b.stats.max) }}</div>
                    </div>
                    <div class="stat-card stat-card--secondary">
                        <div class="stat-label">P5 / P50 / P95</div>
                        <div class="stat-value">{{ '%.3f'|format(b.stats.p5) }} / {{ '%.3f'|format(b.stats.median) }} / {{ '%.3f'|format(b.stats.p95) }}</div>
                    </div>
                    {% endif %}
                    <div class="stat-card stat-card--secondary">
                        <div class="stat-label">Examples</div>
                        <div class="stat-value">{{ b.num_examples }}</div>
                    </div>
                </div>
                {% if b.per_example_scores and b.per_example_scores | length > 0 %}
                <div class="mt-3">
                    <p class="bench-subtitle">Per-example Scores</p>
                    <div class="ppl-samples">
                        {% for score in b.per_example_scores %}
                        <span class="ppl-chip">{{ '%.3f'|format(score) }}</span>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}
{% endfor %}
</div>
